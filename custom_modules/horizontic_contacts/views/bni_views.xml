<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Regiones -->
    <record id="bni_region_view_list" model="ir.ui.view">
        <field name="name">bni.region.list</field>
        <field name="model">bni.region</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="bni_region_action" model="ir.actions.act_window">
        <field name="name">Regiones BNI</field>
        <field name="res_model">bni.region</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Grupos / Capitulos -->
    <record id="bni_grupo_view_list" model="ir.ui.view">
        <field name="name">bni.grupo.list</field>
        <field name="model">bni.grupo</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="region_id"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="bni_grupo_view_search" model="ir.ui.view">
        <field name="name">bni.grupo.search</field>
        <field name="model">bni.grupo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="region_id"/>
                <filter name="inactive" string="Archivados" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_region" string="Region" context="{'group_by': 'region_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bni_grupo_action" model="ir.actions.act_window">
        <field name="name">Grupos / Capitulos BNI</field>
        <field name="res_model">bni.grupo</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Actividades -->
    <record id="bni_actividad_view_list" model="ir.ui.view">
        <field name="name">bni.actividad.list</field>
        <field name="model">bni.actividad</field>
        <field name="arch" type="xml">
            <list>
                <field name="categoria"/>
                <field name="name"/>
                <field name="descripcion" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="bni_actividad_view_form" model="ir.ui.view">
        <field name="name">bni.actividad.form</field>
        <field name="model">bni.actividad</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="categoria"/>
                        <field name="descripcion"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bni_actividad_view_search" model="ir.ui.view">
        <field name="name">bni.actividad.search</field>
        <field name="model">bni.actividad</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="categoria"/>
                <filter name="inactive" string="Archivadas" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_categoria" string="Categoria" context="{'group_by': 'categoria'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bni_actividad_action" model="ir.actions.act_window">
        <field name="name">Actividades BNI</field>
        <field name="res_model">bni.actividad</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
